generator client {
  provider     = "prisma-client"
  output       = "../generated/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum OrganizationRole {
  OWNER
  ADMIN
  CONTRACT_MANAGER
  LEGAL_OFFICER
  DEPARTMENT_MANAGER
  FINANCE_OFFICER
  PROCUREMENT_OFFICER
  CONTRACT_OWNER
  AUDITOR
  VIEWER
}

enum ContractRequestStatus {
  DRAFT
  SUBMITTED
  TRIAGED
  CONVERTED
  CANCELLED
}

enum ContractStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  ACTIVE
  CANCELLED
}

enum ContractRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ReviewStepStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  SKIPPED
}

enum DocumentStatus {
  PENDING
  AVAILABLE
  QUARANTINED
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  identityProvider    String               @map("identity_provider")
  subject             String
  email               String?
  displayName         String?              @map("display_name")
  memberships         Membership[]
  sentInvitations     Invitation[]         @relation("InvitationInviter")
  acceptedInvitations Invitation[]         @relation("InvitationAccepter")
  auditEvents         AuditEvent[]
  requestedContracts  ContractRequest[]    @relation("ContractRequester")
  triagedRequests     ContractRequest[]    @relation("ContractRequestAssignee")
  contractReviews     ContractReviewStep[]
  createdVersions     ContractVersion[]
  uploadedDocuments   ContractDocument[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@unique([identityProvider, subject])
  @@index([email])
  @@map("users")
}

model Organization {
  id               String             @id @default(uuid()) @db.Uuid
  slug             String             @unique
  name             String
  description      String?
  timezone         String             @default("Africa/Addis_Ababa")
  settings         Json               @default("{}")
  status           OrganizationStatus @default(ACTIVE)
  memberships      Membership[]
  departments      Department[]
  invitations      Invitation[]
  auditEvents      AuditEvent[]
  contractRequests ContractRequest[]
  contracts        Contract[]
  documents        ContractDocument[]
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@map("organizations")
}

model Membership {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  role           OrganizationRole
  status         MembershipStatus       @default(ACTIVE)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  departments    DepartmentMembership[]
  ownedContracts Contract[]
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@map("memberships")
}

model Department {
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String                 @map("organization_id") @db.Uuid
  parentId         String?                @map("parent_id") @db.Uuid
  code             String
  name             String
  description      String?
  isActive         Boolean                @default(true) @map("is_active")
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent           Department?            @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children         Department[]           @relation("DepartmentHierarchy")
  memberships      DepartmentMembership[]
  contractRequests ContractRequest[]
  contracts        Contract[]
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  @@unique([organizationId, code])
  @@index([organizationId, parentId])
  @@map("departments")
}

model DepartmentMembership {
  departmentId String     @map("department_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  isManager    Boolean    @default(false) @map("is_manager")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@id([departmentId, membershipId])
  @@index([membershipId])
  @@map("department_memberships")
}

model Invitation {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  email            String
  role             OrganizationRole
  tokenHash        String           @unique @map("token_hash")
  status           InvitationStatus @default(PENDING)
  invitedByUserId  String           @map("invited_by_user_id") @db.Uuid
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  expiresAt        DateTime         @map("expires_at")
  acceptedAt       DateTime?        @map("accepted_at")
  revokedAt        DateTime?        @map("revoked_at")
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy        User             @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy       User?            @relation("InvitationAccepter", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([organizationId, status, email])
  @@index([expiresAt])
  @@map("invitations")
}

model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  action         String
  entityType     String       @map("entity_type")
  entityId       String?      @map("entity_id")
  metadata       Json         @default("{}")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}

model ContractRequest {
  id                   String                @id @default(uuid()) @db.Uuid
  organizationId       String                @map("organization_id") @db.Uuid
  departmentId         String                @map("department_id") @db.Uuid
  requesterUserId      String                @map("requester_user_id") @db.Uuid
  assignedToUserId     String?               @map("assigned_to_user_id") @db.Uuid
  requestNumber        String                @map("request_number")
  title                String
  description          String
  contractType         String                @map("contract_type")
  counterpartyName     String                @map("counterparty_name")
  estimatedValueMinor  BigInt?               @map("estimated_value_minor")
  currency             String                @default("ETB")
  desiredEffectiveDate DateTime?             @map("desired_effective_date") @db.Date
  riskLevel            ContractRiskLevel     @default(MEDIUM) @map("risk_level")
  status               ContractRequestStatus @default(DRAFT)
  submittedAt          DateTime?             @map("submitted_at")
  triagedAt            DateTime?             @map("triaged_at")
  convertedAt          DateTime?             @map("converted_at")
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department           Department            @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  requester            User                  @relation("ContractRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  assignedTo           User?                 @relation("ContractRequestAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  contract             Contract?
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  @@unique([organizationId, requestNumber])
  @@index([organizationId, status, createdAt])
  @@index([requesterUserId, status])
  @@map("contract_requests")
}

model Contract {
  id                String               @id @default(uuid()) @db.Uuid
  organizationId    String               @map("organization_id") @db.Uuid
  requestId         String?              @unique @map("request_id") @db.Uuid
  departmentId      String               @map("department_id") @db.Uuid
  ownerMembershipId String               @map("owner_membership_id") @db.Uuid
  contractNumber    String               @map("contract_number")
  title             String
  contractType      String               @map("contract_type")
  counterpartyName  String               @map("counterparty_name")
  valueMinor        BigInt?              @map("value_minor")
  currency          String               @default("ETB")
  riskLevel         ContractRiskLevel    @default(MEDIUM) @map("risk_level")
  status            ContractStatus       @default(DRAFT)
  effectiveDate     DateTime?            @map("effective_date") @db.Date
  expirationDate    DateTime?            @map("expiration_date") @db.Date
  approvedAt        DateTime?            @map("approved_at")
  activatedAt       DateTime?            @map("activated_at")
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  request           ContractRequest?     @relation(fields: [requestId], references: [id], onDelete: SetNull)
  department        Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  owner             Membership           @relation(fields: [ownerMembershipId], references: [id], onDelete: Restrict)
  versions          ContractVersion[]
  reviewSteps       ContractReviewStep[]
  documents         ContractDocument[]
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@unique([organizationId, contractNumber])
  @@index([organizationId, status, updatedAt])
  @@index([departmentId, status])
  @@map("contracts")
}

model ContractVersion {
  id              String             @id @default(uuid()) @db.Uuid
  contractId      String             @map("contract_id") @db.Uuid
  versionNumber   Int                @map("version_number")
  title           String
  summary         String?
  content         String
  changeNote      String?            @map("change_note")
  createdByUserId String             @map("created_by_user_id") @db.Uuid
  contract        Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdBy       User               @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  documents       ContractDocument[]
  createdAt       DateTime           @default(now()) @map("created_at")

  @@unique([contractId, versionNumber])
  @@index([contractId, createdAt])
  @@map("contract_versions")
}

model ContractDocument {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  contractId        String           @map("contract_id") @db.Uuid
  contractVersionId String?          @map("contract_version_id") @db.Uuid
  uploadedByUserId  String           @map("uploaded_by_user_id") @db.Uuid
  objectKey         String           @unique @map("object_key")
  originalName      String           @map("original_name")
  mimeType          String           @map("mime_type")
  sizeBytes         BigInt           @map("size_bytes")
  sha256            String
  status            DocumentStatus   @default(PENDING)
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract          Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractVersion   ContractVersion? @relation(fields: [contractVersionId], references: [id], onDelete: SetNull)
  uploadedBy        User             @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@index([organizationId, contractId, createdAt])
  @@index([contractVersionId])
  @@map("contract_documents")
}

model ContractReviewStep {
  id             String           @id @default(uuid()) @db.Uuid
  contractId     String           @map("contract_id") @db.Uuid
  sequence       Int
  round          Int              @default(1)
  name           String
  requiredRole   OrganizationRole @map("required_role")
  assignedUserId String?          @map("assigned_user_id") @db.Uuid
  status         ReviewStepStatus @default(PENDING)
  comment        String?
  decidedAt      DateTime?        @map("decided_at")
  contract       Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  assignedUser   User?            @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@unique([contractId, round, sequence])
  @@index([assignedUserId, status])
  @@map("contract_review_steps")
}
