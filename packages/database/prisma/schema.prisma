generator client {
  provider     = "prisma-client"
  output       = "../generated/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum OrganizationRole {
  OWNER
  ADMIN
  CONTRACT_MANAGER
  LEGAL_OFFICER
  DEPARTMENT_MANAGER
  FINANCE_OFFICER
  PROCUREMENT_OFFICER
  CONTRACT_OWNER
  AUDITOR
  VIEWER
}

enum ContractRequestStatus {
  DRAFT
  SUBMITTED
  TRIAGED
  CONVERTED
  CANCELLED
}

enum ContractStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  ACTIVE
  CANCELLED
}

enum ContractRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ReviewStepStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  SKIPPED
}

enum DocumentStatus {
  PENDING
  AVAILABLE
  QUARANTINED
  ARCHIVED
}

enum DocumentCategory {
  CONTRACT
  AMENDMENT
  SUPPORTING
  EVIDENCE
  CORRESPONDENCE
  OTHER
}

enum DocumentConfidentiality {
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum ObligationKind {
  OBLIGATION
  MILESTONE
}

enum ObligationStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  WAIVED
}

enum ObligationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RenewalType {
  AUTO_RENEW
  MANUAL_RENEW
  NON_RENEWING
}

enum RenewalDecision {
  PENDING
  RENEW
  RENEGOTIATE
  TERMINATE
}

enum OperationalAlertType {
  OBLIGATION_DUE
  OBLIGATION_OVERDUE
  NOTICE_DEADLINE
  CONTRACT_EXPIRY
}

enum OperationalAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum OperationalAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum LibraryItemStatus {
  ACTIVE
  ARCHIVED
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model User {
  id                   String               @id @default(uuid()) @db.Uuid
  identityProvider     String               @map("identity_provider")
  subject              String
  email                String?
  displayName          String?              @map("display_name")
  memberships          Membership[]
  sentInvitations      Invitation[]         @relation("InvitationInviter")
  acceptedInvitations  Invitation[]         @relation("InvitationAccepter")
  auditEvents          AuditEvent[]
  requestedContracts   ContractRequest[]    @relation("ContractRequester")
  triagedRequests      ContractRequest[]    @relation("ContractRequestAssignee")
  contractReviews      ContractReviewStep[]
  createdVersions      ContractVersion[]
  uploadedDocuments    ContractDocument[]
  completedObligations ContractObligation[] @relation("ObligationCompleter")
  renewalDecisions     ContractRenewal[]    @relation("RenewalDecisionMaker")
  acknowledgedAlerts   OperationalAlert[]   @relation("AlertAcknowledger")
  documentRevisions    DocumentRevision[]
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  @@unique([identityProvider, subject])
  @@index([email])
  @@map("users")
}

model Organization {
  id                String               @id @default(uuid()) @db.Uuid
  slug              String               @unique
  name              String
  description       String?
  timezone          String               @default("Africa/Addis_Ababa")
  settings          Json                 @default("{}")
  status            OrganizationStatus   @default(ACTIVE)
  memberships       Membership[]
  departments       Department[]
  invitations       Invitation[]
  auditEvents       AuditEvent[]
  contractRequests  ContractRequest[]
  contracts         Contract[]
  documents         ContractDocument[]
  obligations       ContractObligation[]
  renewals          ContractRenewal[]
  operationalAlerts OperationalAlert[]
  clauses           ClauseLibraryItem[]
  contractTemplates ContractTemplate[]
  notificationRules NotificationRule[]
  notificationDeliveries NotificationDelivery[]
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@map("organizations")
}

model Membership {
  id                  String                 @id @default(uuid()) @db.Uuid
  organizationId      String                 @map("organization_id") @db.Uuid
  userId              String                 @map("user_id") @db.Uuid
  role                OrganizationRole
  status              MembershipStatus       @default(ACTIVE)
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  departments         DepartmentMembership[]
  ownedContracts      Contract[]
  assignedObligations ContractObligation[]
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@map("memberships")
}

model Department {
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String                 @map("organization_id") @db.Uuid
  parentId         String?                @map("parent_id") @db.Uuid
  code             String
  name             String
  description      String?
  isActive         Boolean                @default(true) @map("is_active")
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent           Department?            @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children         Department[]           @relation("DepartmentHierarchy")
  memberships      DepartmentMembership[]
  contractRequests ContractRequest[]
  contracts        Contract[]
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  @@unique([organizationId, code])
  @@index([organizationId, parentId])
  @@map("departments")
}

model DepartmentMembership {
  departmentId String     @map("department_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  isManager    Boolean    @default(false) @map("is_manager")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@id([departmentId, membershipId])
  @@index([membershipId])
  @@map("department_memberships")
}

model Invitation {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  email            String
  role             OrganizationRole
  tokenHash        String           @unique @map("token_hash")
  status           InvitationStatus @default(PENDING)
  invitedByUserId  String           @map("invited_by_user_id") @db.Uuid
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  expiresAt        DateTime         @map("expires_at")
  acceptedAt       DateTime?        @map("accepted_at")
  revokedAt        DateTime?        @map("revoked_at")
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy        User             @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy       User?            @relation("InvitationAccepter", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([organizationId, status, email])
  @@index([expiresAt])
  @@map("invitations")
}

model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  action         String
  entityType     String       @map("entity_type")
  entityId       String?      @map("entity_id")
  metadata       Json         @default("{}")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}

model ContractRequest {
  id                   String                @id @default(uuid()) @db.Uuid
  organizationId       String                @map("organization_id") @db.Uuid
  departmentId         String                @map("department_id") @db.Uuid
  requesterUserId      String                @map("requester_user_id") @db.Uuid
  assignedToUserId     String?               @map("assigned_to_user_id") @db.Uuid
  requestNumber        String                @map("request_number")
  title                String
  description          String
  contractType         String                @map("contract_type")
  counterpartyName     String                @map("counterparty_name")
  estimatedValueMinor  BigInt?               @map("estimated_value_minor")
  currency             String                @default("ETB")
  desiredEffectiveDate DateTime?             @map("desired_effective_date") @db.Date
  riskLevel            ContractRiskLevel     @default(MEDIUM) @map("risk_level")
  status               ContractRequestStatus @default(DRAFT)
  submittedAt          DateTime?             @map("submitted_at")
  triagedAt            DateTime?             @map("triaged_at")
  convertedAt          DateTime?             @map("converted_at")
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department           Department            @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  requester            User                  @relation("ContractRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  assignedTo           User?                 @relation("ContractRequestAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  contract             Contract?
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  @@unique([organizationId, requestNumber])
  @@index([organizationId, status, createdAt])
  @@index([requesterUserId, status])
  @@map("contract_requests")
}

model Contract {
  id                String               @id @default(uuid()) @db.Uuid
  organizationId    String               @map("organization_id") @db.Uuid
  requestId         String?              @unique @map("request_id") @db.Uuid
  departmentId      String               @map("department_id") @db.Uuid
  ownerMembershipId String               @map("owner_membership_id") @db.Uuid
  contractNumber    String               @map("contract_number")
  title             String
  contractType      String               @map("contract_type")
  counterpartyName  String               @map("counterparty_name")
  valueMinor        BigInt?              @map("value_minor")
  currency          String               @default("ETB")
  riskLevel         ContractRiskLevel    @default(MEDIUM) @map("risk_level")
  status            ContractStatus       @default(DRAFT)
  effectiveDate     DateTime?            @map("effective_date") @db.Date
  expirationDate    DateTime?            @map("expiration_date") @db.Date
  approvedAt        DateTime?            @map("approved_at")
  activatedAt       DateTime?            @map("activated_at")
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  request           ContractRequest?     @relation(fields: [requestId], references: [id], onDelete: SetNull)
  department        Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  owner             Membership           @relation(fields: [ownerMembershipId], references: [id], onDelete: Restrict)
  versions          ContractVersion[]
  reviewSteps       ContractReviewStep[]
  documents         ContractDocument[]
  obligations       ContractObligation[]
  renewal           ContractRenewal?
  operationalAlerts OperationalAlert[]
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@unique([organizationId, contractNumber])
  @@index([organizationId, status, updatedAt])
  @@index([departmentId, status])
  @@map("contracts")
}

model ContractVersion {
  id               String             @id @default(uuid()) @db.Uuid
  contractId       String             @map("contract_id") @db.Uuid
  versionNumber    Int                @map("version_number")
  title            String
  summary          String?
  content          String
  changeNote       String?            @map("change_note")
  createdByUserId  String             @map("created_by_user_id") @db.Uuid
  sourceTemplateId String?            @map("source_template_id") @db.Uuid
  contract         Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdBy        User               @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  sourceTemplate   ContractTemplate?  @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  documents        ContractDocument[]
  createdAt        DateTime           @default(now()) @map("created_at")

  @@unique([contractId, versionNumber])
  @@index([contractId, createdAt])
  @@index([sourceTemplateId])
  @@map("contract_versions")
}

model ClauseLibraryItem {
  id              String                   @id @default(uuid()) @db.Uuid
  organizationId  String                   @map("organization_id") @db.Uuid
  code            String
  category        String
  titleEn         String                   @map("title_en")
  titleAm         String                   @map("title_am")
  bodyEn          String                   @map("body_en")
  bodyAm          String                   @map("body_am")
  guidance        String?
  riskLevel       ContractRiskLevel        @default(MEDIUM) @map("risk_level")
  status          LibraryItemStatus        @default(ACTIVE)
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateClauses ContractTemplateClause[]
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  @@unique([organizationId, code])
  @@index([organizationId, status, category])
  @@map("clause_library_items")
}

model ContractTemplate {
  id                String                   @id @default(uuid()) @db.Uuid
  organizationId    String                   @map("organization_id") @db.Uuid
  code              String
  contractType      String                   @map("contract_type")
  nameEn            String                   @map("name_en")
  nameAm            String                   @map("name_am")
  descriptionEn     String?                  @map("description_en")
  descriptionAm     String?                  @map("description_am")
  status            LibraryItemStatus        @default(ACTIVE)
  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clauses           ContractTemplateClause[]
  generatedVersions ContractVersion[]
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  @@unique([organizationId, code])
  @@index([organizationId, status, contractType])
  @@map("contract_templates")
}

model ContractTemplateClause {
  templateId String            @map("template_id") @db.Uuid
  clauseId   String            @map("clause_id") @db.Uuid
  sequence   Int
  isRequired Boolean           @default(true) @map("is_required")
  template   ContractTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  clause     ClauseLibraryItem @relation(fields: [clauseId], references: [id], onDelete: Restrict)

  @@id([templateId, clauseId])
  @@unique([templateId, sequence])
  @@index([clauseId])
  @@map("contract_template_clauses")
}

model ContractDocument {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  contractId        String           @map("contract_id") @db.Uuid
  contractVersionId String?          @map("contract_version_id") @db.Uuid
  uploadedByUserId  String           @map("uploaded_by_user_id") @db.Uuid
  objectKey         String           @unique @map("object_key")
  originalName      String           @map("original_name")
  title             String?
  description       String?
  category          DocumentCategory @default(CONTRACT)
  confidentiality   DocumentConfidentiality @default(INTERNAL)
  tags              String[]         @default([])
  mimeType          String           @map("mime_type")
  sizeBytes         BigInt           @map("size_bytes")
  sha256            String
  status            DocumentStatus   @default(PENDING)
  retentionUntil    DateTime?        @map("retention_until") @db.Date
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract          Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractVersion   ContractVersion? @relation(fields: [contractVersionId], references: [id], onDelete: SetNull)
  uploadedBy        User             @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  pages             DocumentPage[]
  revisions         DocumentRevision[]
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@index([organizationId, contractId, createdAt])
  @@index([organizationId, status, category, createdAt])
  @@index([contractVersionId])
  @@map("contract_documents")
}

model DocumentPage {
  id         String           @id @default(uuid()) @db.Uuid
  documentId String           @map("document_id") @db.Uuid
  pageNumber Int              @map("page_number")
  title      String?
  content    String           @default("")
  document   ContractDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@unique([documentId, pageNumber])
  @@index([documentId])
  @@map("document_pages")
}

model DocumentRevision {
  id              String           @id @default(uuid()) @db.Uuid
  documentId      String           @map("document_id") @db.Uuid
  revisionNumber  Int              @map("revision_number")
  summary         String?
  pages           Json
  createdByUserId String           @map("created_by_user_id") @db.Uuid
  document        ContractDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy       User             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime         @default(now()) @map("created_at")

  @@unique([documentId, revisionNumber])
  @@index([documentId, createdAt])
  @@map("document_revisions")
}

model ContractReviewStep {
  id             String           @id @default(uuid()) @db.Uuid
  contractId     String           @map("contract_id") @db.Uuid
  sequence       Int
  round          Int              @default(1)
  name           String
  requiredRole   OrganizationRole @map("required_role")
  assignedUserId String?          @map("assigned_user_id") @db.Uuid
  status         ReviewStepStatus @default(PENDING)
  comment        String?
  decidedAt      DateTime?        @map("decided_at")
  contract       Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  assignedUser   User?            @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@unique([contractId, round, sequence])
  @@index([assignedUserId, status])
  @@map("contract_review_steps")
}

model ContractObligation {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  contractId        String             @map("contract_id") @db.Uuid
  ownerMembershipId String             @map("owner_membership_id") @db.Uuid
  kind              ObligationKind     @default(OBLIGATION)
  title             String
  description       String?
  dueDate           DateTime           @map("due_date") @db.Date
  priority          ObligationPriority @default(MEDIUM)
  status            ObligationStatus   @default(OPEN)
  reminderDays      Int[]              @default([30, 14, 7]) @map("reminder_days")
  completionNote    String?            @map("completion_note")
  completedAt       DateTime?          @map("completed_at")
  completedByUserId String?            @map("completed_by_user_id") @db.Uuid
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract          Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  owner             Membership         @relation(fields: [ownerMembershipId], references: [id], onDelete: Restrict)
  completedBy       User?              @relation("ObligationCompleter", fields: [completedByUserId], references: [id], onDelete: SetNull)
  alerts            OperationalAlert[]
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([organizationId, status, dueDate])
  @@index([contractId, dueDate])
  @@index([ownerMembershipId, status, dueDate])
  @@map("contract_obligations")
}

model ContractRenewal {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @map("organization_id") @db.Uuid
  contractId       String             @unique @map("contract_id") @db.Uuid
  renewalType      RenewalType        @map("renewal_type")
  renewalDate      DateTime           @map("renewal_date") @db.Date
  noticeDeadline   DateTime?          @map("notice_deadline") @db.Date
  noticePeriodDays Int?               @map("notice_period_days")
  decision         RenewalDecision    @default(PENDING)
  decisionNote     String?            @map("decision_note")
  decisionAt       DateTime?          @map("decision_at")
  decidedByUserId  String?            @map("decided_by_user_id") @db.Uuid
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract         Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  decidedBy        User?              @relation("RenewalDecisionMaker", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  alerts           OperationalAlert[]
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@index([organizationId, decision, renewalDate])
  @@index([organizationId, noticeDeadline])
  @@map("contract_renewals")
}

model OperationalAlert {
  id                   String                   @id @default(uuid()) @db.Uuid
  organizationId       String                   @map("organization_id") @db.Uuid
  contractId           String                   @map("contract_id") @db.Uuid
  obligationId         String?                  @map("obligation_id") @db.Uuid
  renewalId            String?                  @map("renewal_id") @db.Uuid
  dedupeKey            String                   @unique @map("dedupe_key")
  type                 OperationalAlertType
  severity             OperationalAlertSeverity
  title                String
  dueAt                DateTime                 @map("due_at")
  status               OperationalAlertStatus   @default(OPEN)
  acknowledgedAt       DateTime?                @map("acknowledged_at")
  acknowledgedByUserId String?                  @map("acknowledged_by_user_id") @db.Uuid
  organization         Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract             Contract                 @relation(fields: [contractId], references: [id], onDelete: Cascade)
  obligation           ContractObligation?      @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  renewal              ContractRenewal?         @relation(fields: [renewalId], references: [id], onDelete: Cascade)
  acknowledgedBy       User?                    @relation("AlertAcknowledger", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)
  notificationDeliveries NotificationDelivery[]
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  @@index([organizationId, status, severity, dueAt])
  @@index([contractId, status])
  @@map("operational_alerts")
}

model NotificationRule {
  id                 String                   @id @default(uuid()) @db.Uuid
  organizationId     String                   @map("organization_id") @db.Uuid
  name               String
  channel            NotificationChannel
  recipient          String
  alertTypes         OperationalAlertType[]   @map("alert_types")
  minimumSeverity    OperationalAlertSeverity @default(INFO) @map("minimum_severity")
  enabled            Boolean                  @default(true)
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries         NotificationDelivery[]
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  @@index([organizationId, enabled])
  @@map("notification_rules")
}

model NotificationDelivery {
  id             String                     @id @default(uuid()) @db.Uuid
  organizationId String                     @map("organization_id") @db.Uuid
  ruleId         String                     @map("rule_id") @db.Uuid
  alertId        String                     @map("alert_id") @db.Uuid
  channel        NotificationChannel
  recipient      String
  subject        String
  body           String
  status         NotificationDeliveryStatus @default(PENDING)
  attemptCount   Int                        @default(0) @map("attempt_count")
  providerId     String?                    @map("provider_id")
  lastError      String?                    @map("last_error")
  sentAt         DateTime?                  @map("sent_at")
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule           NotificationRule           @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  alert          OperationalAlert           @relation(fields: [alertId], references: [id], onDelete: Cascade)
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")

  @@unique([ruleId, alertId])
  @@index([organizationId, status, createdAt])
  @@map("notification_deliveries")
}
