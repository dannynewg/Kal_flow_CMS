{
  "name": "Kal_flow CMS",
  "dockerComposeFile": "../infrastructure/docker/compose.yaml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/Kal_flow_CMS",
  "runServices": [
    "postgres",
    "keycloak-postgres",
    "redis",
    "minio",
    "keycloak"
  ],
  "shutdownAction": "stopCompose",
  "postCreateCommand": "corepack enable && node scripts/configure-codespaces.mjs && pnpm install --frozen-lockfile && pnpm check",
  "postStartCommand": "bash scripts/start-codespaces-preview.sh",
  "postAttachCommand": "node scripts/configure-codespaces.mjs --print",
  "forwardPorts": [3000, 4000, 8080, 9001],
  "portsAttributes": {
    "3000": {
      "label": "Kal_flow private preview",
      "onAutoForward": "openBrowserOnce",
      "visibility": "private"
    },
    "4000": {
      "label": "Kal_flow API",
      "onAutoForward": "silent",
      "visibility": "private"
    },
    "8080": {
      "label": "Keycloak",
      "onAutoForward": "silent",
      "visibility": "private"
    },
    "9001": {
      "label": "MinIO console",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore",
    "visibility": "private"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "Prisma.prisma",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker",
        "EditorConfig.EditorConfig"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "files.eol": "\n"
      }
    }
  },
  "remoteUser": "node"
}
