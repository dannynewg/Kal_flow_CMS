{
  "name": "kal-flow-cms",
  "version": "0.0.0",
  "private": true,
  "description": "Kal_flow contract management system monorepo",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm --filter './packages/**' build && pnpm --filter './apps/**' build",
    "check": "node scripts/verify-foundation.mjs && pnpm db:generate && pnpm -r --if-present check",
    "dev": "pnpm --filter './apps/**' --parallel dev",
    "dev:api": "pnpm --filter @kal-flow/api dev",
    "dev:web": "pnpm --filter @kal-flow/web dev",
    "dev:worker": "pnpm --filter @kal-flow/worker dev",
    "preview:start": "bash scripts/start-codespaces-preview.sh",
    "preview:stop": "bash scripts/stop-codespaces-preview.sh",
    "preview:logs": "tail -f .codespaces/preview.log",
    "db:generate": "pnpm --filter @kal-flow/database generate",
    "db:migrate": "pnpm --filter @kal-flow/database migrate:dev",
    "db:seed": "pnpm --filter @kal-flow/database seed",
    "db:studio": "pnpm --filter @kal-flow/database studio",
    "format": "pnpm -r --if-present format",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "infra:config": "docker compose -f infrastructure/docker/compose.yaml config",
    "infra:up": "docker compose -f infrastructure/docker/compose.yaml up -d postgres keycloak-postgres redis minio keycloak",
    "infra:down": "docker compose -f infrastructure/docker/compose.yaml down",
    "infra:reset": "docker compose -f infrastructure/docker/compose.yaml down --volumes"
  }
}
