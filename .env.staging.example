APP_DOMAIN=staging.kalflow.example
IDP_DOMAIN=identity.staging.kalflow.example
STORAGE_DOMAIN=storage.staging.kalflow.example
KAL_FLOW_IMAGE=kal-flow-staging:latest

POSTGRES_DB=kal_flow
POSTGRES_USER=kal_flow
POSTGRES_PASSWORD=replace-with-a-random-database-password
KEYCLOAK_DB_PASSWORD=replace-with-a-random-keycloak-database-password
KEYCLOAK_ADMIN=kal-flow-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-random-keycloak-admin-password
KEYCLOAK_WEB_CLIENT_SECRET=replace-with-a-random-oidc-client-secret
AUTH_SECRET=replace-with-at-least-32-random-characters
S3_ACCESS_KEY=replace-with-a-random-storage-access-key
S3_SECRET_KEY=replace-with-a-random-storage-secret-key
